@startuml

' CapsuleAI master MVP Use Case Diagram. Stable UC-* IDs are reserved for later specifications.
' Review status: Baseline Draft; this diagram does not approve or change upstream scope.
' Sources: BRD v0.3; PRD v0.2; SRS v0.2.1; Business Rules v0.1.1.
' Process authority: Initial files/CapsuleAI_Scrum_Development_Workflow.md, Sections 10 and 40.
' Packages group actor goals; they are not implementation modules.

left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 15
skinparam ranksep 35

title CapsuleAI - MVP Use Case Diagram

' Primary role; sign-in state is a precondition where applicable, not a separate Guest actor.
actor "User" as User

' Genuine external participants; deployment boundaries of internal capabilities are not actors.
' Email Delivery Service: SI-003 and FR-AUTH-003/004; recovery only, no invented email verification.
actor "Email Delivery\nService" as EmailDelivery
' Device Location Service: HW-003 and FR-WEATHER-001/002; external OS location with consent.
actor "Device Location\nService" as DeviceLocation
' Weather Information Provider: SI-002 and FR-WEATHER-003/004; selected-context information.
actor "Weather Information\nProvider" as WeatherProvider
' External Shopping Destination: SI-004, FR-SHOP-005/006/007 and BRULE-SHOP-002.
actor "External Shopping\nDestination" as ShoppingDestination

rectangle "CapsuleAI" {

    package "Account & Onboarding" {
        ' UC-001 traces to JRN-01, FEAT-AUTH-001, FR-AUTH-001, BRULE-AUTH-002, BRULE-AUTH-003.
        usecase "UC-001\nRegister Account" as UC001
        ' UC-002 traces to JRN-01, FEAT-AUTH-001, FR-AUTH-002, FR-AUTH-005, BRULE-AUTH-001.
        usecase "UC-002\nLog In" as UC002
        ' UC-003 traces to JRN-01, FEAT-AUTH-001, FR-AUTH-007, BRULE-AUTH-006.
        usecase "UC-003\nLog Out" as UC003
        ' UC-004 traces to JRN-01, FEAT-AUTH-001, FR-AUTH-003, FR-AUTH-004, SI-003, BRULE-AUTH-004, BRULE-AUTH-005.
        usecase "UC-004\nReset Password" as UC004
        ' UC-005 traces to JRN-01, FEAT-PROF-001, FR-PROF-002, FR-PROF-003, FR-PROF-005, FR-PROF-006, FR-PROF-008, BRULE-PROF-001, BRULE-PROF-002.
        usecase "UC-005\nUpdate Personalization Profile" as UC005
        ' UC-006 traces to JRN-01, JRN-04, FEAT-PROF-002, FR-WEATHER-001, FR-WEATHER-002, FR-WEATHER-003, SI-002, HW-003, BRULE-PROF-003, BRULE-OUT-006.
        usecase "UC-006\nSet Location Context" as UC006
    }

    package "Digital Wardrobe" {
        ' UC-007 traces to JRN-02, FEAT-AI-001, FEAT-AI-002, FEAT-GAR-001, FR-AI-001, FR-AI-002, FR-AI-003, FR-AI-007, FR-AI-008, FR-GAR-003, FR-GAR-004, BRULE-GAR-001, BRULE-GAR-002, BRULE-GAR-003.
        usecase "UC-007\nAdd Garment" as UC007
        ' UC-008 traces to JRN-03, FEAT-WAR-001, FEAT-WAR-003, FEAT-GAR-001, FR-WAR-001, FR-WAR-002, FR-WAR-007, BRULE-GAR-003, BRULE-HIST-001.
        usecase "UC-008\nView Wardrobe" as UC008
        ' UC-009 traces to JRN-03, FEAT-WAR-002, FEAT-GAR-001, FR-WAR-003, FR-WAR-006, FR-GAR-011, BRULE-GAR-001, BRULE-GAR-009.
        usecase "UC-009\nEdit Garment" as UC009
        ' UC-010 traces to JRN-03, FEAT-WAR-002, FR-WAR-004, FR-WAR-005, BRULE-GAR-009, BRULE-HIST-002.
        usecase "UC-010\nRemove Garment" as UC010
    }

    package "Outfit Recommendation & Personalization" {
        ' UC-011 traces to JRN-04, FEAT-OUT-001, FEAT-OUT-002, FEAT-PERS-003, FR-OUT-001, FR-OUT-003, FR-OUT-005, FR-OUT-010, FR-OUT-011, BRULE-OUT-008, BRULE-OUT-009, BRULE-PERS-003, BRULE-PERS-004.
        usecase "UC-011\nGet Outfit Recommendations" as UC011
        ' UC-012 traces to JRN-04, FEAT-OUT-003, FR-OUT-014, FR-OUT-015, FR-OUT-016, FR-OUT-017, BRULE-OUT-010.
        usecase "UC-012\nShuffle Garment Slot" as UC012
        ' UC-013 traces to JRN-04, JRN-05, FEAT-PERS-001, FEAT-PERS-003, FR-PERS-001, FR-PERS-002, FR-PERS-003, FR-PERS-005, BRULE-PERS-001, BRULE-PERS-006.
        usecase "UC-013\nProvide Outfit Feedback" as UC013
        ' UC-014 traces to JRN-04, JRN-05, FEAT-PERS-002, FEAT-PERS-003, FR-WEAR-001, FR-WEAR-002, FR-WEAR-003, FR-WEAR-009, FR-WEAR-011, BRULE-WEAR-001, BRULE-WEAR-002, BRULE-PERS-005.
        usecase "UC-014\nRecord Wear Event" as UC014
    }

    package "Wear History" {
        ' UC-015 traces to JRN-05, FEAT-ANL-001, FEAT-PERS-002, FR-ANL-001, FR-ANL-002, FR-ANL-006, BRULE-WEAR-003, BRULE-HIST-002.
        usecase "UC-015\nView Wear History" as UC015
        ' UC-016 traces to JRN-05, FEAT-PERS-002, FEAT-ANL-001, FEAT-PERS-003, FR-WEAR-006, FR-WEAR-010, FR-ANL-007, BRULE-WEAR-004, BRULE-WEAR-006, BRULE-PERS-006.
        usecase "UC-016\nCorrect Wear Event" as UC016
        ' UC-017 traces to JRN-05, FEAT-PERS-002, FEAT-ANL-001, FEAT-PERS-003, FR-WEAR-007, FR-WEAR-008, FR-WEAR-010, BRULE-WEAR-005, BRULE-WEAR-006, BRULE-PERS-006.
        usecase "UC-017\nRemove Wear Event" as UC017
