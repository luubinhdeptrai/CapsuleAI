    package "Wardrobe Intelligence" {
        ' UC-018 traces to JRN-05, FEAT-ANL-001, FR-ANL-003, FR-ANL-004, FR-ANL-005, BRULE-HIST-001, BRULE-HIST-002.
        usecase "UC-018\nView Wardrobe Utilization" as UC018
        ' UC-019 traces to JRN-06, FEAT-ANL-002, FR-ANL-008, FR-ANL-009, FR-ANL-011, FR-ANL-015, BRULE-COV-001, BRULE-COV-004, BRULE-COV-005.
        usecase "UC-019\nView Wardrobe Coverage" as UC019
        ' UC-020 traces to JRN-06, FEAT-GAP-001, FR-GAP-001, FR-GAP-002, FR-GAP-004, BRULE-GAP-001, BRULE-GAP-002.
        usecase "UC-020\nView Wardrobe Gaps" as UC020
    }

    package "Strategic Shopping" {
        ' UC-021 traces to JRN-07, FEAT-SHOP-001, FR-SHOP-001, FR-SHOP-002, FR-SHOP-003, FR-SHOP-004, BRULE-SHOP-001, BRULE-SHOP-003.
        usecase "UC-021\nView Shopping Recommendations" as UC021
        ' UC-022 traces to JRN-07, FEAT-MULT-001, FEAT-SHOP-001, FR-MULT-001, FR-MULT-002, FR-MULT-003, FR-MULT-005, FR-MULT-006, FR-MULT-007, FR-MULT-008, BRULE-MULT-001, BRULE-MULT-003, BRULE-MULT-004, BRULE-MULT-008.
        usecase "UC-022\nEvaluate Candidate Garment" as UC022
        ' UC-023 traces to JRN-07, FEAT-SHOP-002, FR-SHOP-005, FR-SHOP-006, FR-SHOP-007, SI-004, BRULE-SHOP-002, BRULE-SHOP-003.
        usecase "UC-023\nOpen External Shopping Link" as UC023
    }
}

