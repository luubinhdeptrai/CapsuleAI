    package "Wardrobe : wardrobe" as Wardrobe #DCFCE7 {
        component "api\nWardrobe Public Contract\nConfirmed inputs / ownership / readiness" as WardrobeAPI <<public>> #BBF7D0
        component "adapter.in\nGarment / Wardrobe API Adapter" as WardrobeIn <<private adapter>> #FAFFFA
        component "application\nConfirm / Correct / Maintain use cases\nAccepted actions; media lifecycle work" as WardrobeApp <<private core>> #F0FDF4
        component "domain\nGarment truth / Membership\nSaveable; evaluation readiness" as WardrobeDomain <<private core>> #F0FDF4
        component "application.ports\nOwned Wardrobe Persistence\nGarment Analysis / Media Storage" as WardrobePorts <<private ports>> #F0FDF4
        component "adapter.out.persistence\nWardrobe Persistence Adapter\nConfirmed state / actions / durable work" as WardrobeStore <<private adapter>> #FAFFFA
        component "adapter.out.integration\nPython AI Adapter / ACL\nObject Storage Adapter" as WardrobeExternal <<private adapter>> #FAFFFA
