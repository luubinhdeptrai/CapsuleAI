        component "adapter.in\nAccess / Recovery API Adapter" as IdentityIn <<private adapter>> #F8FAFF
        component "application\nAccount / Session / Reset use cases\nCoherent transitions + action outcomes" as IdentityApp <<private core>> #EFF6FF
        component "domain\nCredentials / Session / Reset policy" as IdentityDomain <<private core>> #EFF6FF
        component "application.ports\nOwned Authority Persistence\nRecovery Delivery" as IdentityPorts <<private ports>> #EFF6FF
        component "adapter.out.persistence\nIdentity Persistence Adapter\nAccount / session / reset / actions" as IdentityStore <<private adapter>> #F8FAFF
        component "adapter.out.integration\nRecovery Email Adapter" as IdentityExternal <<private adapter>> #F8FAFF
    }

    package "Personal Context : personalcontext" as Context #CCFBF1 {
        component "api\nPersonal Context Public Contract\nDeclared / current / limited context" as ContextAPI <<public>> #99F6E4
        component "adapter.in\nProfile / Location API Adapter" as ContextIn <<private adapter>> #FAFFFE
        component "application\nProfile / Selected Context use cases\nEffective withdrawal; UC-006 acquisition" as ContextApp <<private core>> #F0FDFA
        component "domain\nPreferences / Needs / Context policy" as ContextDomain <<private core>> #F0FDFA
        component "application.ports\nOwned Context Persistence\nWeather Evidence" as ContextPorts <<private ports>> #F0FDFA
        component "adapter.out.persistence\nPersonal Context Persistence Adapter" as ContextStore <<private adapter>> #FAFFFE
        component "adapter.out.integration\nWeather Provider Adapter / ACL" as ContextExternal <<private adapter>> #FAFFFE
