    package "Wardrobe Intelligence : wardrobeintelligence" as Intelligence #EDE9FE {
        component "api\nWardrobe Intelligence Public Contract\nCoverage / Gaps / Utility / Shopping" as IntelligenceAPI <<public>> #DDD6FE
        component "adapter.in\nIntelligence / Shopping API Adapter" as IntelligenceIn <<private adapter>> #FDFBFF
        component "application\nAssess / Preview / Advise use cases\nCurrent complete same-basis evaluation" as IntelligenceApp <<private core>> #F5F3FF
        component "domain\nCoverage / Gap / Multiplier policy\nHypothetical utility and result states" as IntelligenceDomain <<private core>> #F5F3FF
        component "application.ports\nOwned Persistence; Wardrobe / Context\nEvaluation Policy / Commercial Evidence" as IntelligencePorts <<private ports>> #F5F3FF
        component "adapter.out.persistence\nWardrobe Intelligence Persistence Adapter\nJustified owned state; no result-store mandate" as IntelligenceStore <<private adapter>> #FDFBFF
        component "adapter.out.local / integration\nPublished Owner / Evaluation Adapters\nCommercial / Shopping Adapter / ACL" as IntelligenceExternal <<private adapter>> #FDFBFF
