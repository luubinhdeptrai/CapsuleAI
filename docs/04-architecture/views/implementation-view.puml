    package "Outfit Advice and Use : outfitadviceanduse" as Outfits #FEF3C7 {
        component "api\nOutfit Advice / Use Public Contract\nAdvice, feedback, Wear, reported-use" as OutfitsAPI <<public>> #FDE68A
        component "api\nOutfit Evaluation Semantics\nCaller-input identity / hard validity\nOwned / historical / hypothetical" as Evaluation <<public policy>> #FDE68A
        component "adapter.in\nAdvice / Feedback / Wear API Adapter" as OutfitsIn <<private adapter>> #FFFEF8
        component "application\nDaily / Shuffle / Use coordination\nWear actions + coherent survivor effects" as OutfitsApp <<private core>> #FFFBEB
        component "domain\nOutfit evaluation / Ranking / Feedback\nWear / History / Effective evidence" as OutfitsDomain <<private core>> #FFFBEB
        component "application.ports\nOwned Use Persistence\nCurrent Wardrobe / Personal Context" as OutfitsPorts <<private ports>> #FFFBEB
        component "adapter.out.persistence\nOutfit Advice and Use Persistence Adapter\nFeedback / Wear / history / actions / work" as OutfitsStore <<private adapter>> #FFFEF8
        component "adapter.out.local\nWardrobe / Personal Context Adapters" as OutfitsLocal <<private adapter>> #FFFEF8
